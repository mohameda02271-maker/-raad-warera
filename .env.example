DISCORD_TOKEN=your_discord_bot_token_here
WARERA_API_KEY=your_warera_api_key_here
# MU: the 24-character unit id is safest (a name like KEMET-CORE searches and picks the biggest match)
MU_ID=your_military_unit_id_here
# Who may run the owner commands (Administrators always can). Comma separated ids.
OWNER_ROLE_ID=
OWNER_USER_ID=
# Alerts (leave empty to turn off)
ALERT_CHANNEL_ID=
WEEKLY_CHANNEL_ID=
# Country to watch for battles (24-char WarEra country id). Empty = the MU's country.
COUNTRY_ID=
# Weekly summary time, UTC. WEEKLY_DAY: 0=Monday ... 6=Sunday
WEEKLY_DAY=0
WEEKLY_HOUR=18
# Battle check interval in seconds (minimum 60)
BATTLE_POLL_SECONDS=120
